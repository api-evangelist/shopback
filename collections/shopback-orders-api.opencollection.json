{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shopback Orders API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Cancel order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://integrations-sandbox.shopback.com/posi-sandbox/v1/instore/order/:referenceId/cancel",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "Date",
                "value": ""
              },
              {
                "name": "X-ShopBack-Idempotent-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "referenceId",
                "value": "",
                "type": "path",
                "description": "The unique payment attempt identifier generated by the POS terminal that was sent in the request to `POST /v1/instore/order/create` or `POST /v1/instore/order/scan`."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Use this endpoint to cancel a payment before processing. Cancellations are not allowed once a customer has swiped-to-pay on ShopBack’s mobile application."
        },
        {
          "info": {
            "name": "Create order - QR / URL (dynamic)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://integrations-sandbox.shopback.com/posi-sandbox/v1/instore/order/create",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "Date",
                "value": ""
              },
              {
                "name": "X-ShopBack-Idempotent-Id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Use this endpoint to create an order to accept payment using ShopBack’s dynamic QR code or to accept payments for an in-store context through a customer-facing app or website. This endpoint creates a payment order with the dynamic QR code or relevant URL for redirect."
        },
        {
          "info": {
            "name": "Get order status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://integrations-sandbox.shopback.com/posi-sandbox/v1/instore/order/:referenceId",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "Date",
                "value": ""
              },
              {
                "name": "X-ShopBack-Idempotent-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "referenceId",
                "value": "",
                "type": "path",
                "description": "The unique payment attempt identifier generated by the POS terminal that was sent in the request to `POST /v1/instore/order/create` or `POST /v1/instore/order/scan`."
              }
            ]
          },
          "docs": "Use this endpoint to check for the status and details of an order."
        },
        {
          "info": {
            "name": "Order refund",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://integrations-sandbox.shopback.com/posi-sandbox/v1/instore/order/:referenceId/refund",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "Date",
                "value": ""
              },
              {
                "name": "X-ShopBack-Idempotent-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "referenceId",
                "value": "",
                "type": "path",
                "description": "The unique payment attempt identifier generated by the POS terminal that was sent in the request to `POST /v1/instore/order/create` or `POST /v1/instore/order/scan`."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Use this endpoint to refund captured orders with ShopBack."
        },
        {
          "info": {
            "name": "Scan consumer QR",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://integrations-sandbox.shopback.com/posi-sandbox/v1/instore/order/scan",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "Date",
                "value": ""
              },
              {
                "name": "X-ShopBack-Idempotent-Id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Use this endpoint to create an order to initiate payment using ShopBack’s consumer-presented QR code."
        },
        {
          "info": {
            "name": "Get order status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://integrations-sandbox.shopback.com/order/:uuid",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-ShopBack-Idempotent-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "order uuid"
              }
            ]
          },
          "docs": "Get order status"
        },
        {
          "info": {
            "name": "Create order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://integrations-sandbox.shopback.com/order/initiate",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-ShopBack-Idempotent-Id",
                "value": ""
              }
            ]
          },
          "docs": "This is where you can initiate an order with ShopBack, by using the **initiateOrder** method. We also provide a number of methods to refund orders. For example if the consumer returns one (or all) item(s) of an order, you can initiate a full or partial refund. You would be asked to send us the SKU number of the items to be refunded."
        },
        {
          "info": {
            "name": "Order refund",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://integrations-sandbox.shopback.com/order/:orderUuid/refund",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-ShopBack-Idempotent-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "orderUuid",
                "value": "",
                "type": "path",
                "description": "order uuid"
              }
            ]
          },
          "docs": "Order refund"
        }
      ]
    }
  ],
  "bundled": true
}